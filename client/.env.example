# Production: public signaling service URL (must use wss on an HTTPS site).
# Local development automatically uses Vite's /signal proxy.
VITE_SIGNALING_URL=
# Optional public HTTPS frontend URL used in QR codes (defaults to current origin).
VITE_PUBLIC_APP_URL=
# Optional TURN relay for restrictive networks. Prefer short-lived credentials.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
