# Render supplies PORT automatically. Copy this file to .env for local use.
PORT=3001
# Set true to serve client/dist and signaling from one service after npm run build.
SERVE_CLIENT=false
# Render's RENDER_EXTERNAL_URL is automatically added to the exact origin allowlist.
# Exact browser origins, comma separated. Replace with your deployed Vercel URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Unused invitations expire after five minutes; paired connections after two hours.
SESSION_TTL_MS=300000
ACTIVE_SESSION_TTL_MS=7200000
MAX_SESSIONS=200
MAX_CONNECTIONS=500
